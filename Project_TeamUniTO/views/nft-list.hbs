<main class="nft-market">
  <section class="nft-market__header">
    <div>
      <p class="eyebrow">Collezione NFT</p>
      <h1>{{title}}</h1>
      <p>
        Copie digitali e asset collegati al mercato dei libri su Liquid, con
        prezzi, royalties e metadati pronti per il flusso di vendita.
      </p>
    </div>
    <a class="button button--secondary" href="/">Torna al market</a>
  </section>

  <section class="nft-market__grid" aria-label="NFT disponibili">
    {{#each nfts}}
      <article class="nft-card">
        <a class="nft-card__media nft-card__media--{{fileKind}}" href="/nfts/{{id}}" aria-label="Apri {{title}}">
          <span>{{mediaLabel}}</span>
        </a>

        <div class="nft-card__body">
          <div class="nft-card__heading">
            <p class="asset-card__label">{{#if fileType}}{{fileType}}{{else}}Asset Liquid{{/if}}</p>
            <h2>{{title}}</h2>
          </div>

          <dl class="nft-card__meta">
            <div>
              <dt>Prezzo</dt>
              <dd>{{#if price}}{{price}}{{else}}Non disponibile{{/if}}</dd>
            </div>
            <div>
              <dt>Royalties</dt>
              <dd>{{#if royaltyPercentage}}{{royaltyPercentage}}%{{else}}Non disponibile{{/if}}</dd>
            </div>
          </dl>

          <div class="nft-card__hash">
            <span>Payment hash</span>
            <code>{{shortPaymentHash}}</code>
          </div>

          <a class="button" href="/nfts/{{id}}">Visualizza NFT</a>
        </div>
      </article>
    {{/each}}
  </section>
</main>
