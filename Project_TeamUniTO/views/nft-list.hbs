<main class="nft-market">
  <section class="nft-market__header">
    <div>
      <p class="eyebrow">NFT collection</p>
      <h1>{{title}}</h1>
      <p>
        Digital copies and assets connected to the Liquid book market, with
        prices, royalties, and metadata ready for the trading flow.
      </p>
    </div>
    <a class="button button--secondary" href="/">Back to market</a>
  </section>

  <section class="nft-market__grid" aria-label="Available NFTs">
    {{#each nfts}}
      <article class="nft-card">
        <a class="nft-card__media nft-card__media--{{fileKind}}" href="/nfts/{{id}}" aria-label="Open {{title}}">
          <span>{{mediaLabel}}</span>
        </a>

        <div class="nft-card__body">
          <div class="nft-card__heading">
            <p class="asset-card__label">{{#if fileType}}{{fileType}}{{else}}Liquid asset{{/if}}</p>
            <h2>{{title}}</h2>
          </div>

          <dl class="nft-card__meta">
            <div>
              <dt>Price</dt>
              <dd>{{#if price}}{{price}}{{else}}Unavailable{{/if}}</dd>
            </div>
            <div>
              <dt>Royalties</dt>
              <dd>{{#if royaltyPercentage}}{{royaltyPercentage}}%{{else}}Unavailable{{/if}}</dd>
            </div>
          </dl>

          <div class="nft-card__hash">
            <span>Payment hash</span>
            <code>{{shortPaymentHash}}</code>
          </div>

          <a class="button" href="/nfts/{{id}}">View NFT</a>
        </div>
      </article>
    {{/each}}
  </section>
</main>
