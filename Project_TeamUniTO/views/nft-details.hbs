<main class="nft-details">
  <header class="nft-details__header">
    <div>
      <p class="eyebrow">NFT details</p>
      <h1>{{#if title}}{{title}}{{else}}Digital asset information{{/if}}</h1>
      <p>
        Asset data ready to be connected to network state and the buy/sell flow.
      </p>
    </div>
    <a class="button button--secondary" href="/nfts">Back to NFTs</a>
  </header>

  <div class="nft-details__layout">
    <section class="nft-preview" aria-label="NFT preview">
      <div class="nft-preview__art">
        <span>{{#if fileType}}{{fileType}}{{else}}NFT{{/if}}</span>
      </div>
      <div class="nft-preview__summary">
        <p>Price</p>
        <strong>{{#if price}}{{price}}{{else}}Unavailable{{/if}}</strong>
      </div>
    </section>

    <div class="nft-details__content">
      <section class="nft-details__panel" aria-labelledby="payment-info-title">
        <h2 id="payment-info-title">Payment</h2>
        <dl class="nft-details__grid">
          <div class="nft-details__item nft-details__item--wide">
            <dt>Payment hash</dt>
            <dd class="nft-details__hash">
              {{#if paymentHash}}
                {{paymentHash}}
              {{else}}
                Unavailable
              {{/if}}
            </dd>
          </div>
        </dl>
      </section>

      <section class="nft-details__panel" aria-labelledby="file-info-title">
        <h2 id="file-info-title">File</h2>
        <dl class="nft-details__grid">
          <div class="nft-details__item nft-details__item--wide">
            <dt>File name</dt>
            <dd>
              {{#if fileUrl}}
                <a href="{{fileUrl}}" target="_blank" rel="noopener noreferrer">
                  {{#if fileName}}{{fileName}}{{else}}Open NFT file{{/if}}
                </a>
              {{else}}
                {{#if fileName}}{{fileName}}{{else}}Unavailable{{/if}}
              {{/if}}
            </dd>
          </div>

          {{#if fileType}}
            <div class="nft-details__item">
              <dt>File type</dt>
              <dd>{{fileType}}</dd>
            </div>
          {{/if}}

          {{#if fileSize}}
            <div class="nft-details__item">
              <dt>File size</dt>
              <dd>{{fileSize}}</dd>
            </div>
          {{/if}}
        </dl>
      </section>

      <section class="nft-details__panel" aria-labelledby="price-info-title">
        <h2 id="price-info-title">Price and royalties</h2>
        <dl class="nft-details__grid">
          <div class="nft-details__item">
            <dt>Price</dt>
            <dd>{{#if price}}{{price}}{{else}}Unavailable{{/if}}</dd>
          </div>

          {{#if minPrice}}
            <div class="nft-details__item">
              <dt>Minimum price</dt>
              <dd>{{minPrice}}</dd>
            </div>
          {{/if}}

          {{#if maxPrice}}
            <div class="nft-details__item">
              <dt>Maximum price</dt>
              <dd>{{maxPrice}}</dd>
            </div>
          {{/if}}

          <div class="nft-details__item">
            <dt>Royalty percentage</dt>
            <dd>
              {{#if royaltyPercentage}}
                {{royaltyPercentage}}%
              {{else}}
                Unavailable
              {{/if}}
            </dd>
          </div>
        </dl>
      </section>

      {{#if blockchain}}
        <section class="nft-details__panel" aria-labelledby="blockchain-info-title">
          <h2 id="blockchain-info-title">Blockchain data</h2>
          <dl class="nft-details__grid">
            <div class="nft-details__item">
              <dt>Network</dt>
              <dd>{{blockchain.network}}</dd>
            </div>

            <div class="nft-details__item">
              <dt>Confirmed</dt>
              <dd>{{blockchain.confirmed}}</dd>
            </div>

            {{#if blockchain.blockHeight}}
              <div class="nft-details__item">
                <dt>Block height</dt>
                <dd>{{blockchain.blockHeight}}</dd>
              </div>
            {{/if}}

            {{#if blockchain.assetId}}
              <div class="nft-details__item nft-details__item--wide">
                <dt>Asset ID</dt>
                <dd class="nft-details__hash">{{blockchain.assetId}}</dd>
              </div>
            {{/if}}

            <div class="nft-details__item nft-details__item--wide">
              <dt>Explorer</dt>
              <dd>
                <a href="{{blockchain.explorerUrl}}" target="_blank" rel="noopener noreferrer">
                  Open transaction on Blockstream Explorer
                </a>
              </dd>
            </div>
          </dl>
        </section>
      {{/if}}
    </div>
  </div>
</main>
