<main class="marketplace">
  <section class="marketplace__intro">
    <p class="eyebrow">Marketplace distribuito</p>
    <h1>{{title}}</h1>
    <p>
      Una prima interfaccia per libri digitali su Liquid, con vendita primaria,
      rivendita, split automatico e preparazione PSET.
    </p>
  </section>

  <section class="asset-grid" aria-label="Esempi libri digitali">
    <article class="asset-card">
      <div class="asset-card__media asset-card__media--image">
        <span>BOOK</span>
      </div>
      <div class="asset-card__body">
        <p class="asset-card__label">Vendita primaria</p>
        <h2>Simplicity for Builders</h2>
        <p>Prezzo iniziale 100000 sats, split autore 90% e sito 10%.</p>
        <a class="button" href="/api/books">Apri API libri</a>
      </div>
    </article>

    <article class="asset-card">
      <div class="asset-card__media asset-card__media--video">
        <span>PSET</span>
      </div>
      <div class="asset-card__body">
        <p class="asset-card__label">Wallet backend</p>
        <h2>Bridge Liquid Testnet</h2>
        <p>Controllo configurazione LWK, signer, wallet e rete Liquid.</p>
        <a class="button" href="/api/wallet/status">Stato wallet</a>
      </div>
    </article>
  </section>
</main>
