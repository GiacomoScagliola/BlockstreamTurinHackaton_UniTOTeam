<main class="marketplace">
  <section class="marketplace__intro">
    <p class="eyebrow">Marketplace distribuito</p>
    <h1>{{title}}</h1>
    <p>
      Una prima interfaccia per libri digitali su Liquid, con vendita primaria,
      rivendita, split automatico e preparazione PSET.
    </p>
  </section>

  <section class="asset-grid" aria-label="Esempi libri digitali">
    <article class="asset-card">
      <div class="asset-card__media asset-card__media--nft">
        <span>NFT</span>
      </div>
      <div class="asset-card__body">
        <p class="asset-card__label">Collezione Liquid</p>
        <h2>NFT book copies</h2>
        <p>Vista consultabile delle copie digitali, con prezzo, metadati e royalties.</p>
        <a class="button" href="/nfts">Visualizza NFT</a>
      </div>
    </article>
  </section>
</main>
